# Default config for sway
#
# Copy this to ~/.config/sway/config and edit it to your liking.
#
# Read `man 5 sway` for a complete reference.

### Variables
set $mod Mod4
set $terminal foot -e fish
set $fileManager ranger
set $menu wofi --show drun

### Output configuration
# Default wallpaper
output * bg ~/Pictures/wallpaper.jpg fill

### Input configuration
input * {
    xkb_layout "pl"
    natural_scroll enabled
}

### Key bindings
# Basics:
bindsym $mod+Return exec $terminal
bindsym $mod+q kill
bindsym $mod+e exec $fileManager
bindsym $mod+v floating toggle
bindsym $mod+r exec $menu
# Maximize (mimics Hyprland's fullscreen, 1 - keeps bar visible)
bindsym $mod+d layout toggle tabbed split
# Real fullscreen (if needed)
# bindsym $mod+Shift+d fullscreen toggle
bindsym $mod+w exec firefox
bindsym $mod+c exec slack

# Focus
bindsym $mod+Left focus left
bindsym $mod+Right focus right
bindsym $mod+Up focus up
bindsym $mod+Down focus down

bindsym $mod+h focus left
bindsym $mod+l focus right
bindsym $mod+k focus up
bindsym $mod+j focus down

# Move
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Right move right
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Down move down

bindsym $mod+Shift+h move left
bindsym $mod+Shift+l move right
bindsym $mod+Shift+k move up
bindsym $mod+Shift+j move down

# Workspaces:
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9
bindsym $mod+0 workspace number 10

# Move focused container to workspace
bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9
bindsym $mod+Shift+0 move container to workspace number 10

# Cycle workspaces (custom script to avoid looping and create new)
bindsym $mod+Control+Right exec $HOME/.config/sway/scripts/workspace.sh workspace next
bindsym $mod+Control+Left exec $HOME/.config/sway/scripts/workspace.sh workspace prev
bindsym $mod+Control+l exec $HOME/.config/sway/scripts/workspace.sh workspace next
bindsym $mod+Control+h exec $HOME/.config/sway/scripts/workspace.sh workspace prev

# Move to workspace (custom script to avoid looping and create new)
bindsym $mod+Control+Shift+Right exec $HOME/.config/sway/scripts/workspace.sh move next
bindsym $mod+Control+Shift+Left exec $HOME/.config/sway/scripts/workspace.sh move prev
bindsym $mod+Control+Shift+l exec $HOME/.config/sway/scripts/workspace.sh move next
bindsym $mod+Control+Shift+h exec $HOME/.config/sway/scripts/workspace.sh move prev

# Screenshots
bindsym $mod+Shift+s exec grim ~/Pictures/screenshot-$(date +%s).png
bindsym $mod+s exec grim -g "$(slurp)" - | wl-copy

# Rofi (matching Hyprland config's extra bind)
bindsym $mod+Super_L exec rofi -show drun

# Layout stuff
bindsym $mod+p layout toggle split # Best approximation for pseudo
bindsym $mod+i split toggle

# Scratchpad
# Sway has a different scratchpad system, but Hyprland's was commented out.

# Reload the configuration file
bindsym $mod+Shift+c reload

# Exit sway (logs you out of your Wayland session)
bindsym $mod+Shift+e exec swaynag -t warning -m 'You pressed the exit shortcut. Do you really want to exit sway? This will end your Wayland session.' -B 'Yes, exit sway' 'swaymsg exit'

### Appearance
font pango:JetBrainsMono Nerd Font 10
floating_modifier $mod normal
default_border pixel 1
default_floating_border normal
hide_edge_borders none

gaps inner 4
gaps outer 4

### Multimedia keys
bindsym XF86AudioRaiseVolume exec wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+
bindsym XF86AudioLowerVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindsym XF86AudioMute exec wpctl set-volume @DEFAULT_AUDIO_SINK@ toggle
bindsym XF86AudioMicMute exec wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle
bindsym XF86MonBrightnessUp exec brightnessctl -e4 -n2 set 5%+
bindsym XF86MonBrightnessDown exec brightnessctl -e4 -n2 set 5%-

bindsym XF86AudioNext exec playerctl next
bindsym XF86AudioPause exec playerctl play-pause
bindsym XF86AudioPlay exec playerctl play-pause
bindsym XF86AudioPrev exec playerctl previous

### Bar
bar {
    swaybar_command swaybar
    status_command $HOME/.config/sway/scripts/status.sh
    position top
    # Use a slightly larger font or height if supported, 
    # but status_padding is the cleanest way for vertical space
    font pango:JetBrainsMono Nerd Font 10
    
    # Vertical padding for the status line
    status_padding 5
    status_edge_padding 10
    
    colors {
        statusline #f202be
        background #00000000
        # class             border  bg      text
        focused_workspace  #fe85e4 #fe85e4 #f202be
        active_workspace   #fe85e4 #fe85e4 #f202be
        inactive_workspace #00000000 #00000000 #fec2f1
        urgent_workspace   #eb4d4b #eb4d4b #ffffff
        binding_mode       #fe85e4 #fe85e4 #f202be
    }
}

### Autostart
exec dunst
